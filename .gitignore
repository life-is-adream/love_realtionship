# Local credentials and runtime configuration
**/.env
**/.env.*
!**/.env.example

# Large raw media and local source scans (GitHub file-size / redistribution risk)
*.mp4
*.mov
*.mkv
*.avi
书籍/
_learned_relationship_course/ocr_pkg/
_learned_relationship_course/*.png

# Local staging copies and editor/tool metadata
_relationship_coach_cn_backup_*/
_relationship_coach_cn_merged_*/
_relationship_skills_incoming_*/
.trae/
.codex/
.learnings/
**/.workbuddy/
**/.workbuddy-*

# Private relationship context and case data
.agents/skills/relationship-coach-cn/profiles/private-profile.md
.agents/skills/relationship-coach-cn/cases/private/
.agents/skills/relationship-coach-cn/evals/results/local-*
**/*private-profile*.local.*

# Generated dependency/runtime artifacts
**/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.log
__pycache__/
*.py[cod]

# HeartFlow 启动器运行时产物
**/.heartflow.pid
**/heartflow.out.log
**/heartflow.err.log

# 外部收集资料与一次性粘贴稿（不入库）
/外道.zip
/外道/
/pasted-text.txt
relationship-simulator/snap0.txt

# love-learning 构建产物（node scripts/build-love-learning.mjs 可重建；源数据在仓库根 scripts/ 与 恋爱15分钟学习/）
relationship-simulator/public/love-learning/

# 本地语音模型与依赖（约 500MB，不入库；重建方式见 relationship-simulator/voice/README.md）
relationship-simulator/voice/venv/
relationship-simulator/voice/models/
relationship-simulator/voice/wheels/
relationship-simulator/voice/logs/
relationship-simulator/voice/*.tmp
# 角色原声参考音频受版权保护（CC-BY-NC / 未授权），仅本机使用，禁止入库与再分发
relationship-simulator/voice/character_voices/refs/*.wav
# 角色语音试听样本（含真实原声，版权归原版权方，不入库）
relationship-simulator/voice/character_voices/demo/*.wav
relationship-simulator/public/voice-demo/*.wav
# 角色音色评测生成物（含 AI 合成音频、评分数据、盲听页；out/ 整体可重建，不入库）
relationship-simulator/voice/character_voices/eval/out/
# 评测盲听页的网页服务副本（由 eval/report 生成后复制，含合成音频）
relationship-simulator/public/voice-eval/
# 语言标签 2x2 对照页的网页服务副本（由 eval/langtag 生成后复制，含合成音频）
relationship-simulator/public/voice-langtag/
# 说话方式改进对照页的网页服务副本（由 eval/prosody 生成后复制，含合成音频）
relationship-simulator/public/voice-prosody/

# 手工备份副本与 Agent 运行日志（2026-11-03 因 git add -A 被误纳入版本控制后补规则）
# 与既有的 _relationship_coach_cn_backup_*/ 、.trae/ 、.codex/ 同一类：本地时点产物，不入库。
relationship-simulator/_backup-*/
relationship-simulator/.agent-runs/

# C 引擎编译缓存与本机 zig 工具链副本（2026-11-27 补规则：共 22,189 个文件 / 317MB，
# 占未跟踪文件的 99%；均可重建——pip 包 ziglang 自带标准库，缓存由 heartflow-c/build.sh 重新生成）
**/.zigcache/
**/.toolchain/

# 验收证据日志是交付物：docs/ 下的 logs/ 与 quality/reports/ 被 FINAL_ACCEPTANCE 等文档逐条引用，
# 不受上面通用 *.log 规则限制；运行时日志（heartflow.out.log 等）仍不入库。
!relationship-simulator/docs/**/*.log
!relationship-simulator/quality/reports/*.log
