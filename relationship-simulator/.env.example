# Copy this file to `.env` and edit it for your provider.
# The browser talks to local `/api/chat`, and the server forwards upstream.

# MiMo via OpenAI-compatible Chat Completions (token-plan 计费)
LLM_ENDPOINT=https://token-plan-cn.xiaomimimo.com/v1/chat/completions
LLM_API_MODE=chat
LLM_MODEL=mimo-v2.5-pro
LLM_API_KEY=your_mimo_api_key
LLM_MAX_OUTPUT_TOKENS=2048
LLM_REASONING_EFFORT=medium
LLM_TEMPERATURE=1.0
LLM_TOP_P=0.95

# MiMo model IDs you can try:
# LLM_MODEL=mimo-v2.5-pro        # 直出型：0 reasoning tokens，更快更省，适合实时聊天/教练 JSON
# LLM_MODEL=mimo-v2.5            # 推理型：reasoning tokens 高，回复更"想得多"，但偏慢
# LLM_MODEL=mimo-v2.5-thinking

# DeepSeek (chat completions compatibility mode)
# LLM_ENDPOINT=https://api.deepseek.com/chat/completions
# LLM_MODEL=deepseek-chat
# LLM_API_KEY=your_api_key

# Other compatible endpoints
# LLM_ENDPOINT=https://dashscope.aliyuncs.com/compatible-mode/v1/chat/completions
# LLM_MODEL=qwen-plus

# Moonshot/Kimi
# LLM_ENDPOINT=https://api.moonshot.cn/v1/chat/completions
# LLM_MODEL=moonshot-v1-8k

# GLM
# LLM_ENDPOINT=https://open.bigmodel.cn/api/paas/v4/chat/completions
# LLM_MODEL=glm-4-plus

PORT=3000
