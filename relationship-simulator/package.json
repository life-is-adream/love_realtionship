{
  "name": "relationship-simulator",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "heartflow-c\\hf.exe serve --port 3000 --root .",
    "dev": "heartflow-c\\hf.exe serve --port 3000 --root .",
    "start:node": "node server/index.js",
    "dev:node": "node server/index.js",
    "start:bg": "node scripts/start-bg.mjs",
    "check:circular": "heartflow-c\\hf.exe check circular",
    "check:circular:js": "node scripts/check-circular.mjs",
    "check:conventions": "node scripts/check-conventions.mjs",
    "build:index": "node scripts/build-long-index.mjs",
    "test:journey": "node --test test/relationship-intelligence-journey.test.mjs",
    "test:unit": "node --test",
    "test": "node --test && node scripts/check-circular.mjs && node scripts/check-conventions.mjs",
    "gate": "node scripts/run-gates.mjs",
    "release:manifest": "node scripts/release-manifest.mjs",
    "release:check": "node scripts/release-manifest.mjs --check",
    "eval:behavior": "node scripts/eval-behavior.mjs",
    "eval:grounding": "node scripts/eval-grounding.mjs",
    "eval:chat-style-live": "node scripts/eval-chat-style-live.mjs",
    "eval:courses": "node scripts/eval-course-retrieval.mjs",
    "eval:semantics": "node scripts/eval-semantics.mjs",
    "quality:validate": "node quality/scripts/validate-datasets.mjs",
    "quality:index": "node quality/scripts/build-course-index.mjs",
    "quality:semantics": "node quality/scripts/eval-semantics.mjs --split=test --out=quality/reports/semantics-test-2.1.json",
    "quality:retrieval": "node quality/scripts/eval-retrieval.mjs --split=test --mode=hybrid --out=quality/reports/retrieval-test-hybrid.json",
    "quality:practice": "node quality/scripts/eval-practice.mjs --split=test --out=quality/reports/practice-test-2.1.json",
    "quality:parity": "node quality/scripts/check-semantic-parity.mjs",
    "e2e:browser": "node scripts/e2e-browser.mjs"
  },
  "engines": {
    "node": ">=18"
  }
}
