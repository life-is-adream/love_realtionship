{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "heartflow/quality/retrieval.schema.json",
  "title": "HeartFlow course retrieval evaluation dataset",
  "type": "object",
  "required": ["dataset_version", "reviewed_by_human", "annotation_status", "cases"],
  "properties": {
    "dataset_version": { "type": "string", "pattern": "^ret-(dev|test)-2\\.1\\.[0-9]+$" },
    "reviewed_by_human": { "const": false },
    "annotation_status": { "enum": ["synthetic_single_annotator", "independent_double_annotated"] },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "group", "query", "relevant", "candidate_pool_checked", "provenance"],
        "properties": {
          "id": { "type": "string", "pattern": "^ret-(dev|test)-[0-9]{3}$" },
          "group": { "type": "string", "minLength": 1 },
          "query": { "type": "string", "minLength": 2, "maxLength": 300 },
          "relevant": { "type": "array", "minItems": 1, "items": { "type": "integer", "minimum": 1, "maximum": 179 } },
          "alternative_relevant": { "type": "array", "items": { "type": "integer", "minimum": 1, "maximum": 179 } },
          "candidate_pool_checked": { "type": "boolean" },
          "semantic_rewrite": { "type": "boolean" },
          "provenance": { "enum": ["original_synthetic", "manifest_derived", "authorized_anonymized_real"] },
          "notes": { "type": "string" }
        }
      }
    }
  }
}
