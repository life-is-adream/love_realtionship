{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "heartflow/quality/practice.schema.json",
  "title": "HeartFlow practice behavior evaluation dataset",
  "type": "object",
  "required": ["dataset_version", "reviewed_by_human", "cases"],
  "properties": {
    "dataset_version": { "type": "string", "pattern": "^pra-(dev|test)-2\\.1\\.[0-9]+$" },
    "reviewed_by_human": { "const": false },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "group", "scenario_id", "difficulty", "branch", "turns", "expect"],
        "properties": {
          "id": { "type": "string", "pattern": "^pra-(dev|test)-[0-9]{3}$" },
          "group": { "type": "string" },
          "scenario_id": { "enum": ["first-meeting", "low-energy-reply", "low-pressure-invitation", "conflict-repair", "breakup-recovery"] },
          "difficulty": { "enum": ["easy", "normal", "challenging"] },
          "branch": { "enum": ["positive", "uncertain", "declined"] },
          "turns": { "type": "array", "minItems": 1, "maxItems": 6, "items": { "type": "string", "minLength": 1, "maxLength": 1200 } },
          "expect": {
            "type": "object",
            "required": ["ended_by_turn", "boundary_preserved", "max_tension", "no_advance_after_refusal"],
            "properties": {
              "ended_by_turn": { "type": "integer", "minimum": 1, "maximum": 6 },
              "boundary_preserved": { "type": "boolean" },
              "max_tension": { "type": "integer", "minimum": 0, "maximum": 3 },
              "no_advance_after_refusal": { "type": "boolean" },
              "human_reviewed": { "const": false }
            }
          }
        }
      }
    }
  }
}
