  "note": "场景行为合同。状态由服务器从 history 重建，客户端 state 不参与计算。",
  "scenarios": [
    {
      "id": "first-meeting",
      "version": "2.1.0",
      "title": "第一次见面",
      "relationship_context": "刚认识，双方尚未形成承诺；目标是低压力地了解彼此。",
      "difficulty_range": ["easy", "normal", "challenging"],
      "branches": ["positive", "uncertain"],
      "allowed_state": { "tension": [0, 3], "repair": [0, 3] },
      "boundaries": ["不替对方下结论", "不把礼貌当同意", "不追问隐私", "不施加见面压力"],
      "termination_rules": ["连续施压达到 3 时结束", "对方明确拒绝时结束", "用户选择 declined 分支时结束"],
      "learning_objectives": ["用具体内容承接", "提出可拒绝的轻量邀请", "观察对方是否给出具体安排"],
      "dimensions": ["listening", "clarity", "boundary", "naturalness"]
    },
    {
      "id": "low-energy-reply",
      "version": "2.1.0",
      "title": "低能量回复",
      "relationship_context": "对方最近忙或累，回复短；用户容易焦虑并追加消息。",
      "difficulty_range": ["easy", "normal", "challenging"],
      "branches": ["positive", "uncertain"],
      "allowed_state": { "tension": [0, 3], "repair": [0, 3] },
